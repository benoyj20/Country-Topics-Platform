{
  "name": "@countrytopics/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build && node scripts/drop-build-time-pages.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "size": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@countrytopics/contracts": "workspace:*",
    "@countrytopics/domain": "workspace:*",
    "@countrytopics/environment": "workspace:*",
    "@countrytopics/forwarding": "workspace:*",
    "@countrytopics/observability": "workspace:*",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@sentry/browser": "11.4.0",
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/qrcode": "1.5.6",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  }
}
