POSTGRES_DB=countrytopics
POSTGRES_USER=countrytopics
POSTGRES_PASSWORD=countrytopics_dev
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://countrytopics:countrytopics_dev@localhost:5433/countrytopics?sslmode=disable
DATABASE_REPLICA_URL=postgres://countrytopics:countrytopics_dev@localhost:5433/countrytopics?sslmode=disable
# Integration tests wipe this database, so its name must end in _test
TEST_DATABASE_URL=postgres://countrytopics:countrytopics_dev@localhost:5433/countrytopics_test?sslmode=disable
# Signs admin login tokens; "make env" fills in a random value
PAYLOAD_SECRET=
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379
# The shared page cache's own Valkey (the "cache" Compose service), which
# evicts old pages when full; empty uses REDIS_URL, which must never evict
PAGE_CACHE_HOST_PORT=6380
PAGE_CACHE_URL=redis://localhost:6380
# Redis key prefix for job queues
QUEUE_PREFIX=countrytopics
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Country Topics <no-reply@localhost>
# S3-compatible storage for uploads; locally the "storage" Compose service
S3_HOST_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=countrytopics
# Integration tests store uploads here; never the site's bucket
TEST_S3_BUCKET=countrytopics-test
S3_ACCESS_KEY_ID=countrytopics
S3_SECRET_ACCESS_KEY=countrytopics_dev_secret
# Backups (the "backup" Compose service): a daily database dump and a copy of
# uploads, kept 14 days. Locally a bucket in the storage service, on the same
# disk; for the pilot, set all five to another S3-compatible service (such as
# Cloudflare R2) so one failure cannot lose both. Empty values other than the
# bucket fall back to the S3_* ones
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=countrytopics-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The database and uploads as Compose containers reach them (the backup
# service). Empty means the Compose services ("postgres", "storage"); set them
# only when the site uses other ones, such as managed services
CONTAINER_DATABASE_URL=
CONTAINER_S3_ENDPOINT=
# Bibliographic services (Crossref, Open Library) ask for a contact address in
# the requests they get; the privacy policy and terms show it too. Optional
CONTACT_EMAIL=
# Who runs the site (a person's or organisation's name), as the privacy policy
# and terms name them; optional, but needed before the pilot
SITE_OPERATOR=
# Optional: a Google Books API key (Google Cloud project, restricted to the
# Books API) adds Google Books as a backup for ISBNs Open Library does not know
GOOGLE_BOOKS_API_KEY=
# Optional, planned for after the pilot: Internet Archive keys
# (https://archive.org/account/s3.php) let the worker ask the Wayback Machine to
# save fresh copies of links; without them it only finds existing copies
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=
# Optional: a YouTube Data API v3 key (Google Cloud project, restricted to that
# API) lets the worker read video lengths and age restrictions; without it,
# videos are checked with oEmbed only. The prototype uses it too
YOUTUBE_API_KEY=
# Which environment this is: local, staging, or production (ADR 0014). Each
# app refuses to start with another environment's addresses. Local accepts
# only localhost, or a quick-tunnel demo address (*.trycloudflare.com)
APP_ENV=local
# The site's public address; sign-in links and the Google redirect use it
SITE_URL=http://localhost:3000
# Signs sessions; "make env" fills in a random value
BETTER_AUTH_SECRET=
# Google sign-in (redirect URL: SITE_URL + /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated addresses that become admins on first sign-in
ADMIN_EMAILS=
# Only invited addresses (and ADMIN_EMAILS) can create accounts
INVITE_ONLY=true
# Optional: Cloudflare Turnstile on the email sign-in form (both or neither).
# Cloudflare's test keys work locally: site key 1x00000000000000000000AA and
# secret 1x0000000000000000000000000000000AA always pass
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Sentry error reporting for the site and the worker; empty turns it
# off. The project's DSN is in Sentry under Settings > Projects > (project) >
# Client Keys (DSN). SENTRY_ENVIRONMENT labels the reports (default
# "development"); set it to "pilot" on the pilot machine
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Behind a proxy, the header holding the client's address, such as
# cf-connecting-ip behind Cloudflare; sign-in rate limits count per address.
# Set it only when every request comes through that proxy
CLIENT_IP_HEADER=
